{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(tools/talos/talos *)",
      "Bash(./tools/talos/talos *)",
      "Bash(tools/talos/run *)",
      "Bash(./tools/talos/run *)",
      "Bash(uv venv *)",
      "Bash(uv pip install *)",
      "Bash(uv python install *)",
      "Bash(.venv/Scripts/python.exe *)",
      "Bash(.venv/Scripts/python *)",
      "Bash(.venv/bin/python *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/talos/pyrun\" \"$CLAUDE_PROJECT_DIR/tools/talos/hooks/session_status.py\"",
            "timeout": 30,
            "statusMessage": "Loading Talos status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/talos/pyrun\" \"$CLAUDE_PROJECT_DIR/tools/talos/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/talos/pyrun\" \"$CLAUDE_PROJECT_DIR/tools/talos/hooks/inbox.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/talos/pyrun\" \"$CLAUDE_PROJECT_DIR/tools/talos/hooks/stop_reminder.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
